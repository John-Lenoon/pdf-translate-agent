# Copy this file to .env and fill in your local credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=
TRANSLATION_MODEL=
TRANSLATION_FONT_PATH=

# V2 optional local-first cascade. Set V2_LOCAL_MODEL to enable Ollama.
V2_LOCAL_MODEL=qwen3:8b
V2_OLLAMA_ENDPOINT=http://127.0.0.1:11434
# Optional remote reviewer. Falls back to TRANSLATION_MODEL when empty.
V2_REMOTE_MODEL=
V2_LOCAL_CONTEXT_WINDOW=4096
V2_LOCAL_MAX_OUTPUT_TOKENS=512
V2_ENABLE_CHAPTER_SUMMARY=0
# Risk routing calibration (raise coverage only after Golden Set comparison).
V2_REMOTE_RISK_THRESHOLD=0.35
V2_CONTEXT_DEGRADED_WEIGHT=0.35
V2_CALIBRATION_INTERVAL=5
# Optional Chinese reading-layout renderer. Requires Playwright Chromium.
V2_RENDER_MODE=reflow
V2_REFLOW_FONT_FAMILY=Noto Serif CJK SC, Source Han Serif SC, SimSun, serif
